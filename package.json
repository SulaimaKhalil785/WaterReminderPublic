{
  "name": "water-reminder-2",
  "version": "1.0.0",
  "scripts": {
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider expo start --lan",
    "start:hotspot": "cross-env REACT_NATIVE_PACKAGER_HOSTNAME=10.63.206.151 NODE_OPTIONS=--openssl-legacy-provider expo start --lan",
    "start:tunnel": "cross-env NODE_OPTIONS=--openssl-legacy-provider expo start --tunnel",
    "start:dev-client": "cross-env NODE_OPTIONS=--openssl-legacy-provider expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "cross-env NODE_OPTIONS=--openssl-legacy-provider expo start --web",
    "configure": "eas build:configure",
    "deploy-android": "eas build --platform android",
    "deploy-ios": "eas build --platform ios",
    "deploy-all": "eas build --platform all",
    "deploy-list": "eas build:list",
    "submit-android": "eas build --platform android && eas submit --platform android",
    "update": "eas update",
    "postinstall": "node scripts/patch-expo-boost-url.js"
  },
  "dependencies": {
    "@expo/webpack-config": "^0.17.2",
    "@react-native-async-storage/async-storage": "~1.17.3",
    "@react-navigation/bottom-tabs": "^6.5.1",
    "@react-navigation/native": "^6.1.0",
    "@react-navigation/native-stack": "^6.9.5",
    "expo": "~47.0.14",
    "expo-location": "~15.0.1",
    "expo-notifications": "~0.17.0",
    "expo-splash-screen": "~0.17.5",
    "expo-status-bar": "~1.4.2",
    "expo-system-ui": "~2.0.1",
    "expo-updates": "~0.15.6",
    "firebase": "^9.15.0",
    "moment": "^2.29.4",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-native": "0.70.8",
    "react-native": "0.70.8",
    "react-native-calendars": "^1.1292.0",
    "react-native-floating-action": "^1.22.0",
    "react-native-progress": "^5.0.0",
    "react-native-safe-area-context": "4.4.1",
    "react-native-screens": "~3.18.0",
    "react-native-svg": "13.4.0",
    "react-native-web": "~0.18.9",
    "expo-updates": "~0.15.6",
    "expo-system-ui": "~2.0.1",
    "expo-constants": "~14.0.2",
    "expo-location": "~15.0.1",
    "expo-notifications": "~0.17.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@types/react": "~18.0.14",
    "@types/react-native": "~0.70.6",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "cross-env": "^7.0.3",
    "typescript": "^4.6.3"
  },
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  }
}